# Mail configuration for the enquiry forms (/contact, /enquiries, /testimonials).
#
# All server-only. None of these has a NEXT_PUBLIC_ prefix, so none of them
# reaches the browser. Set them in the hosting environment (Production and
# Preview) and in a local .env.local for development. Never commit a real key.

# Required. A sending-only Resend API key. Without it the forms report that the
# message could not be delivered, and the server logs why.
RESEND_API_KEY=

# Optional. Must be an address on a domain verified in Resend.
# Default: Invision Solutions website <website@invisionsolutions.co.uk>
# ENQUIRY_FROM=

# Optional. Where enquiries are delivered.
# Default: the address the site publishes (david@invisionsolutions.co.uk)
# ENQUIRY_TO=

# Nothing reads NEXT_PUBLIC_WEB3FORMS_KEY or any NEXT_PUBLIC_WEB3FORMS_KEY_*
# variable any more. If any are still set in the hosting dashboard, delete them.
